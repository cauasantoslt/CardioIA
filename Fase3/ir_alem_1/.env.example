# CardioIA - Fase 3 (Ir Além 1) - Exemplo de configuração (.env)
# Copie para `.env` se quiser alterar portas ou usar um servidor SMTP real.

# --- API REST ---
CARDIOIA_API_HOST=127.0.0.1
CARDIOIA_API_PORT=5000
CARDIOIA_API_KEY=cardioia-dev-key

# --- Monitor RPA ---
CARDIOIA_POLLING_S=2
CARDIOIA_COOLDOWN_S=600

# --- Disparo de e-mail (deixe SMTP_HOST vazio para modo simulado em outbox/*.eml) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SSL=0
EMAIL_REMETENTE=alertas@cardioia.local
EMAIL_DESTINO=plantao.cardiologia@cardioia.local

# --- Ponte MQTT (opcional) ---
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC_BASE=cardioia/rm566599/wear01

