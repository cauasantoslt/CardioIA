  {
    "id": "fn_eventos",
    "type": "function",
    "z": "tab_cardioia",
    "name": "Histórico de eventos",
    "func": "// Histórico unificado: eventos de alerta + amostras sincronizadas do Edge\nconst lista = context.get('lista') || [];\nconst hora = new Date().toLocaleTimeString('pt-BR');\nconst p = msg.payload || {};\nlet toast = null;\n\nif (msg.topic.endsWith('/alerta')) {\n    const a = p.amostra || {};\n    let desc;\n    if (p.evento === 'ALERTA_RETROATIVO') {\n        desc = `${p.amostras_criticas} amostra(s) crítica(s) registradas OFFLINE foram sincronizadas`;\n        toast = { topic: '⏱ Alerta retroativo (Edge)', payload: desc };\n    } else {\n        desc = (a.alertas || []).join(', ') + (a.bpm != null ? ` | ${a.bpm} bpm, ${a.temp} °C` : '');\n    }\n    lista.unshift({ hora, tipo: p.evento, desc, cor: p.evento === 'NORMALIZADO' ? '#2ecc71' : '#e74c3c' });\n} else {\n    const sync = (flow.get('totalSync') || 0) + 1;\n    flow.set('totalSync', sync);\n    const quando = p.ts ? new Date(p.ts * 1000).toLocaleTimeString('pt-BR') : `uptime ${p.uptime_s}s`;\n    // Para não poluir, registra 1 a cada 10 amostras sincronizadas (e todas as críticas)\n    if (p.sev === 2 || sync % 10 === 1) {\n        lista.unshift({ hora, tipo: 'SYNC', cor: p.sev === 2 ? '#e67e22' : '#3498db',\n                        desc: `#${sync} coletada ${quando}: ${p.bpm} bpm, ${p.temp} °C, ${p.nivel}` });\n    }\n}\nwhile (lista.length > 12) lista.pop();\ncontext.set('lista', lista);\nreturn [{ payload: lista, totalSync: flow.get('totalSync') || 0 }, toast];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 650,
    "wires": [
      [
        "tpl_eventos"
      ],
      [
        "toast_retro"
      ]
    ]
  },
