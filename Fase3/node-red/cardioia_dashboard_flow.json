    "format": "<div style=\"font-size:13px\">\n  <div style=\"margin-bottom:6px;opacity:.8\">Amostras recuperadas do armazenamento offline: <b>{{msg.totalSync}}</b></div>\n  <table style=\"width:100%;border-collapse:collapse\">\n    <tr style=\"text-align:left;opacity:.7\"><th>Hora</th><th>Tipo</th><th>Detalhe</th></tr>\n    <tr ng-repeat=\"e in msg.payload\" style=\"border-top:1px solid rgba(255,255,255,.1)\">\n      <td style=\"white-space:nowrap;padding:3px 6px 3px 0\">{{e.hora}}</td>\n      <td style=\"color:{{e.cor}};font-weight:bold;padding-right:6px\">{{e.tipo}}</td>\n      <td>{{e.desc}}</td>\n    </tr>\n  </table>\n  <div ng-if=\"!msg.payload.length\" style=\"opacity:.6\">Nenhum evento até o momento.</div>\n</div>",
