  {
    "id": "fn_watch",
    "type": "function",
    "z": "tab_cardioia",
    "name": "Watchdog de dados",
    "func": "// Watchdog: indica há quanto tempo chegou a última leitura ao vivo\nconst t = flow.get('ultimaLeituraMs');\nif (!t) { msg.payload = 'Aguardando primeira leitura...'; return msg; }\nconst s = Math.round((Date.now() - t) / 1000);\nmsg.payload = s <= 6 ? `🟢 ao vivo (há ${s}s)` : `🔴 sem dados há ${s}s (verifique Wi-Fi/broker)`;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 400,
    "wires": [
      [
        "txt_watch"
      ]
    ]
  },
