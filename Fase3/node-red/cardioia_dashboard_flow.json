  {
    "id": "tpl_led",
    "type": "ui_template",
    "z": "tab_cardioia",
    "group": "g_alerta",
    "name": "LED virtual de alerta",
    "order": 1,
    "width": "6",
    "height": "5",
    "format": "<style>\n  .cio-wrap { text-align:center; font-family:inherit; }\n  .cio-led { width:84px; height:84px; border-radius:50%; margin:10px auto 6px;\n             border:4px solid rgba(255,255,255,.25); }\n  .cio-normal   { background:#2ecc71; box-shadow:0 0 24px #2ecc71; }\n  .cio-atencao  { background:#f1c40f; box-shadow:0 0 24px #f1c40f; }\n  .cio-critico  { background:#e74c3c; box-shadow:0 0 32px #e74c3c; animation:cio-pisca .6s infinite alternate; }\n  .cio-aguard   { background:#7f8c8d; }\n  @keyframes cio-pisca { from{opacity:1} to{opacity:.3} }\n  .cio-nivel { font-size:22px; font-weight:700; letter-spacing:2px; margin:4px 0 8px; }\n  .cio-alerta { color:#ff6b5b; font-weight:600; margin:2px 0; }\n  .cio-ok { opacity:.75; }\n  .cio-vitals { margin-top:8px; font-size:15px; opacity:.9; }\n</style>\n<div class=\"cio-wrap\">\n  <div class=\"cio-led\" ng-class=\"{\n        'cio-normal':  msg.payload.nivel=='NORMAL',\n        'cio-atencao': msg.payload.nivel=='ATENCAO',\n        'cio-critico': msg.payload.nivel=='CRITICO',\n        'cio-aguard':  !msg.payload.nivel }\"></div>\n  <div class=\"cio-nivel\">{{ msg.payload.nivel || 'AGUARDANDO' }}</div>\n  <div class=\"cio-alerta\" ng-repeat=\"a in msg.payload.alertas\">⚠ {{a}}</div>\n  <div class=\"cio-ok\" ng-if=\"msg.payload.nivel=='NORMAL'\">Sinais vitais dentro dos limites</div>\n  <div class=\"cio-vitals\" ng-if=\"msg.payload.nivel\">\n    ❤ {{msg.payload.bpm}} bpm &nbsp;|&nbsp; 🌡 {{msg.payload.temp | number:1}} °C &nbsp;|&nbsp; 🕒 {{msg.payload.hora}}\n  </div>\n</div>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
