  {
    "id": "fn_fog",
    "type": "function",
    "z": "tab_cardioia",
    "name": "Regras clínicas (Fog)",
    "func": "// ============================================================\n// CAMADA FOG: valida o payload do ESP32, reavalia os limites\n// clínicos (redundância ao Edge) e distribui para os widgets.\n// ============================================================\nconst d = msg.payload;\nif (!d || typeof d.bpm !== 'number') {\n    node.warn('Payload inválido descartado');\n    return null;\n}\n\n// Limites definidos pelo grupo (iguais aos do firmware)\nconst LIM = { bpmMax: 120, bpmMin: 50, tempMax: 38.0, tempMin: 35.0 };\nconst flags = d.alertas || [];\nconst alertas = [];\nlet critico = false;\n\nif (d.bpm > LIM.bpmMax) { alertas.push(`Taquicardia: ${d.bpm} bpm (> ${LIM.bpmMax})`); critico = true; }\nif (d.bpm > 0 && d.bpm < LIM.bpmMin) { alertas.push(`Bradicardia: ${d.bpm} bpm (< ${LIM.bpmMin})`); critico = true; }\nif (flags.includes('SEM_PULSO')) { alertas.push('Sem pulso detectado'); critico = true; }\nif (d.temp !== null && d.temp > LIM.tempMax) { alertas.push(`Febre: ${d.temp.toFixed(1)} °C (> ${LIM.tempMax})`); critico = true; }\nif (d.temp !== null && d.temp < LIM.tempMin) { alertas.push(`Hipotermia: ${d.temp.toFixed(1)} °C (< ${LIM.tempMin})`); critico = true; }\nif (flags.includes('QUEDA')) { alertas.push('Queda detectada (pico de aceleração)'); critico = true; }\nif (flags.includes('IMOBILIDADE')) alertas.push('Ausência de movimento prolongada');\nif (flags.includes('FALHA_SENSOR')) alertas.push('Falha de leitura de sensor');\n\nconst nivel = critico ? 'CRITICO' : (alertas.length ? 'ATENCAO' : 'NORMAL');\n\n// Divergência Edge x Fog (auditoria do algoritmo embarcado)\nif (d.nivel && d.nivel !== nivel) node.warn(`Divergência Edge(${d.nivel}) x Fog(${nivel})`);\n\nflow.set('ultimaLeituraMs', Date.now());\nflow.set('totalLive', (flow.get('totalLive') || 0) + 1);\n\n// Notificação pop-up somente na TRANSIÇÃO para crítico (evita spam)\nconst anterior = context.get('nivelAnterior') || 'NORMAL';\ncontext.set('nivelAnterior', nivel);\nlet toast = null;\nif (nivel === 'CRITICO' && anterior !== 'CRITICO') {\n    toast = { topic: '🚨 ALERTA CRÍTICO - PAC-0001', payload: alertas.join('<br>') };\n}\n\nnode.status({ fill: critico ? 'red' : (alertas.length ? 'yellow' : 'green'), shape: 'dot',\n              text: `${d.bpm} bpm | ${d.temp} °C | ${nivel}` });\n\nreturn [\n    [ { topic: 'FC (bpm)', payload: d.bpm },\n      { topic: 'Limite taquicardia (120)', payload: LIM.bpmMax },\n      { topic: 'Limite bradicardia (50)', payload: LIM.bpmMin } ],\n    d.temp === null ? null :\n    [ { topic: 'Temperatura (°C)', payload: d.temp },\n      { topic: 'Limite febre (38 °C)', payload: LIM.tempMax } ],\n    d.temp === null ? null : { payload: d.temp },\n    d.umid === null ? null : { payload: d.umid },\n    { payload: d.mov },\n    { payload: { nivel, alertas, bpm: d.bpm, temp: d.temp, umid: d.umid,\n                 hora: new Date().toLocaleTimeString('pt-BR') } },\n    toast\n];",
    "outputs": 7,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 160,
    "wires": [
      [
        "chart_fc"
      ],
      [
        "chart_temp"
      ],
