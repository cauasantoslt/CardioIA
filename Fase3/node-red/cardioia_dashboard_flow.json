  {
    "id": "fn_status",
    "type": "function",
    "z": "tab_cardioia",
    "name": "Formatar status",
    "func": "const s = msg.payload || {};\nconst icone = { online: '🟢', sincronizando: '🔄', offline: '🔴' }[s.estado] || '⚪';\nmsg.payload = {\n    estado: `${icone} ${(s.estado || '?').toUpperCase()}${s.motivo === 'lwt' ? ' (queda abrupta - LWT)' : ''}`,\n    backend: s.backend || '-',\n    normal: s.buffer_normal ?? '-',\n    critico: s.buffer_critico ?? '-',\n    capacidade: s.capacidade ?? '-',\n    descartadas: s.descartadas ?? '-',\n    sincronizadas: s.sincronizadas ?? '-',\n    modo: s.modo || '-',\n    rssi: s.rssi ?? '-',\n    uptime: s.uptime_s != null ? `${Math.floor(s.uptime_s/60)} min ${s.uptime_s%60} s` : '-'\n};\nnode.status({ fill: s.estado === 'offline' ? 'red' : 'green', shape: 'dot', text: s.estado });\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 460,
    "wires": [
      [
        "tpl_status"
      ]
    ]
  },
