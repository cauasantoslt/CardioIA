        "tpl_led"
      ],
      [
        "toast_alerta"
      ]
    ],
    "outputLabels": [
      "FC → gráfico",
      "Temp → gráfico",
      "Temp → gauge",
      "Umidade → gauge",
      "Movimento → gauge",
      "LED de alerta",
      "Toast"
    ]
